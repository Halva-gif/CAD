# Your OpenAI-compatible proxy must support tool/function calling.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CAD_MODEL=gpt-6-luna
CAD_STRUCTURED_METHOD=function_calling
CAD_MODEL_MAX_OUTPUT_TOKENS=6000
# Persistent hybrid vector + exact API-name search; lexical is optional/offline.
CAD_RETRIEVAL_MODE=vector
CAD_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_BASE_URL=
OPENAI_EMBEDDINGS_API_KEY=
# CAD_WIKI_DIR=/path/to/py_wiki
# CAD_CATALOG_PATH=/path/to/document_chooser.json
# CAD_INDEX_PATH=/path/to/knowledge.sqlite3
CAD_EMBEDDING_MAX_TOKENS=8000
CAD_RETRIEVAL_K=8
CAD_TOOL_SEARCH_K=5
# Only #, ##, ### split Markdown. No size/paragraph/code splitting.
# Cached tiktoken is used; otherwise budgets count conservative UTF-8 bytes.
CAD_TOKEN_ENCODING=cl100k_base
CAD_KNOWLEDGE_INITIAL_TOKENS=3000
CAD_KNOWLEDGE_TOTAL_TOKENS=5000
CAD_KNOWLEDGE_READ_TOKENS=1600
CAD_AGENT_MAX_TOOL_CALLS=6
CAD_AGENT_MAX_MODEL_CALLS=6
CAD_AGENT_MAX_INPUT_TOKENS=14000
CAD_AGENT_MAX_TOTAL_INPUT_TOKENS=60000
# Execution, validation, debugging and runtime feedback are disabled.
# Old CAD_*_MAX_CHARS and CAD_EXECUTION_TIMEOUT are no longer used.
