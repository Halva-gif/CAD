# OpenAI-compatible proxy. Use its key, API base and model identifier.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CAD_MODEL=gpt-6-luna
# Original vector RAG remains the default. Set lexical only if desired.
CAD_RETRIEVAL_MODE=vector
CAD_EMBEDDING_MODEL=text-embedding-3-small
# Optional separate embeddings provider (if chat proxy lacks embeddings).
OPENAI_EMBEDDINGS_BASE_URL=
OPENAI_EMBEDDINGS_API_KEY=
# function_calling works with tool-compatible proxies; json_schema is optional.
CAD_STRUCTURED_METHOD=function_calling
# Knowledge paths default to this project's catalog and py_wiki directory.
# CAD_CATALOG_PATH=/path/to/document_chooser.json
# CAD_WIKI_DIR=/path/to/py_wiki
CAD_KNOWLEDGE_MAX_CHARS=24000
CAD_TOOL_EXCERPT_MAX_CHARS=12000
CAD_EXECUTION_TIMEOUT=90
# CAD_FREECAD_COMMAND=["/usr/bin/python3"]
# CAD_FREECAD_LIB=/usr/lib/freecad-python3/lib
# CAD_FREECAD_MOD_DIR=/usr/share/freecad/Mod
